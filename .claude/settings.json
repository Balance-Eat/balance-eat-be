{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(./gradlew *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash(make test|./gradlew test|./gradlew.*test)",
        "hooks": [
          {
            "type": "command",
            "command": "make coverage 2>&1 | tail -5"
          }
        ]
      }
    ],
    "PreCommit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "make lint 2>&1 | tail -5"
          }
        ]
      }
    ]
  }
}
